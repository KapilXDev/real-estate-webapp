{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "paths": {
      "@tricity/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@tricity/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@tricity/geo": [
        "../../packages/geo/src/index.ts"
      ]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "types": [
      "node",
      // Multer ships its Express.Multer.File type as a global augmentation. With an explicit
      // `types` array, @types packages are NOT auto-included, so the augmentation is invisible
      // and `Express.Multer` fails to resolve in the upload controller.
      "multer"
    ],
    "typeRoots": [
      "../../node_modules/@types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
