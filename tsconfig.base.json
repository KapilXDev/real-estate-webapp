{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@tricity/contracts": ["./packages/contracts/src/index.ts"],
      "@tricity/domain": ["./packages/domain/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
