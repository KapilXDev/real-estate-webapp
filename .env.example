# Copy to .env and adjust. NEVER commit .env — it is gitignored.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://tricity:tricity_dev_password@localhost:5432/tricity

# --- Auth -------------------------------------------------------------------
# Access tokens are RS256-signed. Generate a keypair for local dev:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Store as base64 so they survive .env and Kubernetes secrets unchanged.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- App --------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
# Leave unset until launch: the site returns `Disallow: /` without it, which prevents
# sample/incomplete data being indexed.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Not yet used (uncomment the matching docker-compose service first) ------
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=tricity
# S3_SECRET_KEY=tricity_dev_password
# S3_BUCKET=tricity-media
# KAFKA_BROKERS=localhost:9092
# REDIS_URL=redis://localhost:6379
