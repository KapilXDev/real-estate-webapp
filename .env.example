# Copy to .env and adjust. NEVER commit .env — it is gitignored.
#
# Loaded by apps/api/src/config/load-env.ts. Values already present in the real environment
# always win over this file, so an injected production DATABASE_URL is never overridden.
# The variable names here must match the zod schema in apps/api/src/config/configuration.ts —
# an unknown name is not a warning, it is simply ignored, and a missing one aborts boot.

# --- Database ---------------------------------------------------------------
# TWO connection strings, and they are NOT interchangeable.
#
# DATABASE_URL is the OWNER: migrations, seed, bootstrap. In local Docker this role is a
# SUPERUSER, because the postgres image makes POSTGRES_USER one.
DATABASE_URL=postgresql://tricity:tricity_dev_password@localhost:5432/tricity
#
# ⚠️ APP_DATABASE_URL is what the API serves requests as, and it is the ONLY reason tenant
# isolation works. A superuser — or any role with BYPASSRLS — ignores row-level security
# entirely: FORCE does not apply and no policy is ever consulted. Serving traffic over
# DATABASE_URL silently turns every policy in migration 0010 into a no-op and lets any
# brokerage read every rival's listings and leads. The API refuses to boot if this resolves
# to a privileged role.
#
# Create the role and give it this password:
#   npm run db:migrate     # 0013 creates tricity_app (NOLOGIN, NOSUPERUSER, NOBYPASSRLS)
#   npm run db:app-role    # sets LOGIN + the password below
APP_DATABASE_URL=postgresql://tricity_app:tricity_app_dev_password@localhost:5432/tricity
# API pool size. Kept separate from worker pools — see the bulkhead note in client.ts.
DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Access tokens are HS256-signed with these secrets. Minimum 32 characters, enforced at boot;
# there is deliberately no default, because a fallback secret means every deployment that forgot
# to set one shares a signing key and any of them can mint tokens for the others.
# Generate a pair:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Must carry an explicit unit (15m, 2h, 7d) — a bare number is interpreted differently.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# How long a just-rotated refresh token keeps working, in seconds.
#
# Refresh tokens rotate and a replay is treated as theft, which revokes the whole family. But a
# browser with two tabs sends both requests carrying the SAME cookie, because neither has seen the
# response that replaced it — so the second looks exactly like a replay. Without this window, two
# concurrent requests after the access cookie expired were enough to sign the agent out
# everywhere. Auth0 and Okta ship the same mechanism. 0 disables it; the schema caps it at 60.
REFRESH_ROTATION_GRACE_SECONDS=10

# --- Outbound messaging (speed-to-lead) --------------------------------------
#
# ⚠️ ONLY `log` IS IMPLEMENTED. It records what WOULD have been sent and sends nothing; the boot
# log says so loudly. Anything else fails at startup rather than silently dropping messages.
MESSAGING_PROVIDER=log

# The kill switch. Strings, not booleans — "false" really means false here.
SPEED_TO_LEAD_ENABLED=true

# WhatsApp only permits a PRE-APPROVED TEMPLATE outside a 24-hour conversation window, and a web
# lead has never messaged us, so the first contact is always one. Names live here because Meta
# approves templates by hand and the copy changes on their timetable, not on a deploy.
SPEED_TO_LEAD_TEMPLATE=lead_acknowledgement
SPEED_TO_LEAD_TEMPLATE_LANGUAGE=en

# Retries apply only to retryable failures — every WhatsApp conversation is billed, so repeating a
# permanent rejection costs money and delays the fallback to a human.
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_BASE_MS=400

# --- Consumer phone OTP -----------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Minimum gap between OTP sends to one destination. SMS-pumping fraud costs real money.
OTP_RESEND_COOLDOWN_SECONDS=60

# --- App --------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Web app ----------------------------------------------------------------
# Where apps/web reaches the API. Server-side only (no NEXT_PUBLIC_ prefix) — listing pages are
# Server Components, and exposing the internal API origin to the browser buys nothing.
#
# ⚠️ REQUIRED IN PRODUCTION. Without it `getLeadStore()` throws at boot rather than silently
# falling back to a local file that an ephemeral filesystem will discard — see lib/leads/store.ts.
API_URL=http://localhost:3001/api

# Which inventory source the site serves.
#   mock  deterministic sample listings (default; isLiveData=false, so the site stays noindexed
#         and RERA attribution is suppressed)
#   api   real inventory from the catalog service
# ⚠️ Do NOT set `api` until there are real listings in the database — it flips isLiveData to true,
# which un-suppresses RERA attribution and allows indexing.
LISTING_PROVIDER=mock

# Origin the BROWSER loads listing photos from. Public (NEXT_PUBLIC_) unlike API_URL, because the
# browser fetches these bytes directly — the API returns a path and this supplies the host.
# Becomes a CDN hostname in production without touching any component.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3001

# --- Frontend ---------------------------------------------------------------
# Leave unset until launch: the site returns `Disallow: /` without it, which prevents
# sample/incomplete data being indexed.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Not yet used (uncomment the matching docker-compose service first) ------
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=tricity
# S3_SECRET_KEY=tricity_dev_password
# S3_BUCKET=tricity-media
# KAFKA_BROKERS=localhost:9092
# REDIS_URL=redis://localhost:6379

# --- Object storage (listing photos) ----------------------------------------
# MinIO locally. Leave MEDIA_ENDPOINT unset against real AWS S3 — see configuration.ts.
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=tricity-media
MEDIA_ACCESS_KEY=tricity
MEDIA_SECRET_KEY=tricity_dev_password

# --- Admin app ---------------------------------------------------------------
# apps/admin talks to the API server-side only — no NEXT_PUBLIC_ prefix, so the browser never
# learns the API origin and never holds a JWT.
API_URL=http://localhost:3001/api

# --- Cache invalidation (admin -> site) --------------------------------------
# The admin tells the site to drop its listing cache after a write, so a published listing shows
# immediately instead of up to 60s later. Must match on BOTH apps.
REVALIDATE_SECRET=change-me-to-a-long-random-string
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
