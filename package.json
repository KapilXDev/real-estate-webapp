{
  "name": "tricity-estate",
  "version": "0.1.0",
  "private": true,
  "description": "Real estate platform for the Chandigarh / Mohali / Kharar tricity market",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace=@tricity/web",
    "api:dev": "npm run start:dev --workspace=@tricity/api",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:generate": "npm run db:generate --workspace=@tricity/api",
    "db:migrate": "npm run db:migrate --workspace=@tricity/api",
    "db:seed": "npm run db:seed --workspace=@tricity/api",
    "db:bootstrap": "npm run db:bootstrap --workspace=@tricity/api --",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nx": "^23.1.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true,
    "cpu-features@0.0.10": true,
    "nx@23.1.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
