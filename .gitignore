# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# nx
.nx/cache
.nx/workspace-data

# env — never commit secrets
.env
.env.*
!.env.example

# captured leads and local data — personal data, never commit
.data/

# docker volumes
infra/docker/volumes/

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*

# Next.js build output for the admin app
apps/admin/.next

# Per-app local env (Next reads these from the app dir, not the repo root)
apps/*/.env.local

# ⚠️ GENERATED, AND ITS CONTENT DEPENDS ON WHICH NEXT COMMAND RAN LAST.
#
# `next dev` writes `import "./.next/dev/types/routes.d.ts"`; `next build` writes
# `./.next/types/...`. So committing it means the file flips back and forth and every branch
# carries a spurious diff — it changed twice in one afternoon here. Worse, whichever variant is
# committed points at a path under the gitignored `.next/`, so on a fresh checkout it references
# a file that does not exist. Both Next commands regenerate it, so there is nothing to lose.
apps/*/next-env.d.ts
